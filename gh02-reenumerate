#!/bin/sh
for d in /sys/bus/usb/devices/*; do
	[ "$(cat "$d/idVendor" 2>/dev/null)" = "10d6" ] || continue
	[ "$(cat "$d/idProduct" 2>/dev/null)" = "4802" ] || continue
	[ "$(tr -d ' ' < "$d/bNumInterfaces")" = "4" ] || continue
	port_path=$(readlink -f "$d/port")
	[ -w "$port_path/disable" ] || { echo "gh02: no port/disable for $d" >&2; continue; }
	echo 1 > "$port_path/disable"
	sleep 1
	echo 0 > "$port_path/disable"
	echo "gh02: re-enumerated $(basename "$d")"
done
